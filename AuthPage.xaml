<Page x:Class="Gilmianova_41.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Gilmianova_41"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage" FontFamily="TW Cen MT" Background="#ffcc99">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Text="Авторизация" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" FontSize="20"></TextBlock>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.ColumnSpan="2"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <TextBlock Text="Логин" Margin="0,0,10,0" Grid.Column="0" Grid.Row="0" 
                   HorizontalAlignment="Center" FontSize="20" 
                   ></TextBlock>
            <TextBox Name="TextBoxLogin" HorizontalAlignment="Center"
                  Grid.Column="1" Grid.Row="0"
                  Height="20" Width="200" ></TextBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.ColumnSpan="2"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <TextBlock Text="Пароль" Margin="0,0,10,0" Grid.Column="0" Grid.Row="1"
                    HorizontalAlignment="Center"
                   FontSize="20"></TextBlock>
            <TextBox Name="TextBoxPassword" Grid.Row="1" Grid.Column="1"
                  HorizontalAlignment="Center"
                 Height="20" Width="200"></TextBox>
        </StackPanel>


        <Button Name="SignInGuestButton" Grid.Column="1" Grid.Row="3"
                Content="Войти как гость" Click="SignInGuestButton_Click"></Button>
        <Button Name="SignInButton" Grid.Row="3" Grid.Column="0"
                Content="Войти" Click="SignInButton_Click"></Button>


        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right">
            <TextBlock Name="captchaOneWord" FontSize="22" Margin="30,0,0,0"></TextBlock>
            <TextBlock Name="captchaTwoWord" FontSize="22" TextDecorations="Strikethrough" Margin="0,5,0,0"></TextBlock>
            <TextBlock Name="captchaThreeWord" FontSize="22" TextDecorations="Strikethrough"></TextBlock>
            <TextBlock Name="captchaFourWord" FontSize="22" TextDecorations="Strikethrough" Margin="0,10,0,0"></TextBlock>
        </StackPanel>
        <StackPanel Orientation="Vertical" Grid.Column="1" Grid.Row="2">
            <TextBlock Text="Капча" Margin="0,0,0,-20"  FontSize="20" HorizontalAlignment="Left"></TextBlock>
            <TextBox Name="CaptchaTextBox"   Height="22" Width="70" 
          HorizontalAlignment="Right"></TextBox>
        </StackPanel>
        
    </Grid>
    
</Page>
