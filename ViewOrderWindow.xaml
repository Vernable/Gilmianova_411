<Window x:Class="Gilmianova_41.ViewOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Gilmianova_41"
        mc:Ignorable="d"
        Title="ViewOrderWindow" Height="450" Width="800">
    <Grid ShowGridLines="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="265"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Дата формирования заказа" FontSize="15" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center"></TextBlock>
        <TextBlock Text="Дата доставки" FontSize="15" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center"></TextBlock>
        <TextBlock Text="ФИО клиента" FontSize="15" Grid.Column="0" Grid.Row="2" VerticalAlignment="Center"></TextBlock>
        <TextBlock Text="Номер заказа" FontSize="15" Grid.Column="0" Grid.Row="3" VerticalAlignment="Center"></TextBlock>
        <TextBlock Text="Пункт выдачи" FontSize="15" Grid.Column="0" Grid.Row="5" VerticalAlignment="Center"></TextBlock>

        <StackPanel Grid.Column="0" Grid.Row="6" HorizontalAlignment="Center" 
                    VerticalAlignment="Center" Orientation="Horizontal">
            <TextBlock Text="Сумма заказа: " FontSize="15"></TextBlock>
            <TextBlock Name="PriceText" FontSize="15"></TextBlock>
            <TextBlock Text=" руб." FontSize="15"></TextBlock>
        </StackPanel>
        <Button Name="SaveButton" Content="Сохранить" Click="SaveButton_Click"
                    Grid.Column="1" Grid.Row="6" HorizontalAlignment="Center" 
                    VerticalAlignment="Center"></Button>

        <DatePicker Name="OrderDate" FontSize="15" Grid.Column="1" Grid.Row="0"></DatePicker>
        <DatePicker Name="OrderDeliveryDateTB" FontSize="15" Grid.Row="1" Grid.Column="1" IsEnabled="False"
                    ></DatePicker>
        <TextBlock Name="ClientNameTB" Grid.Row="2" Grid.Column="1" FontSize="15"></TextBlock>
        <TextBlock Name="OrderIDTB" Grid.Row="3" Grid.Column="1" FontSize="15"></TextBlock>

        <ComboBox Name="PickupCombo" Grid.Column="1" Grid.Row="5" FontSize="15">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Height="50">
                        <Label Content="{Binding PickUpPointIndex}" FontSize="15"></Label>
                        <Label Content="{Binding PickUpPointCity}" FontSize="15"></Label>
                        <Label Content="{Binding PickUpPointStreet}" FontSize="15"></Label>
                        <Label Content="{Binding PickUpPointNumberHouse}" FontSize="15"></Label>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>


        <ListView Name="ProductListView" Grid.Row="4" Grid.ColumnSpan="2">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ShowGridLines="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"></ColumnDefinition>
                            <ColumnDefinition Width="600"></ColumnDefinition>
                            <ColumnDefinition Width="auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Image Width="200" Grid.Column="0" Stretch="UniformToFill"
                       HorizontalAlignment="Center" Grid.RowSpan="4">
                            <Image.Source>
                                <Binding Path="ProductPhotoPath">
                                    <Binding.TargetNullValue>
                                        <ImageSource>
                                            images/picture.png
                                        </ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <StackPanel Orientation="Vertical" Grid.Column="1" Grid.RowSpan="3">
                            <TextBlock Text="{Binding ProductName}" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left"
                           FontSize="20" TextWrapping="Wrap"></TextBlock>
                            <TextBlock Text="{Binding ProductDescription}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left"
                           FontSize="17" ></TextBlock>
                            <TextBlock Text="{Binding ProductManufacturer}" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left"
                           FontSize="17" ></TextBlock>
                            <TextBlock Text="{Binding ProductCost, StringFormat={}{0:0} рублей}" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Left"
                           FontSize="20" ></TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="3" Orientation="Horizontal">
                            <Button Name="MinusButton" Content="-" Width="35" Click="MinusButton_Click"
                                    Height="40"></Button>
                            <TextBlock Name="TBOrderCount" Text="{Binding Quantity}" FontSize="40"
                        HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                            <Button Name="PlusButton" Content="+" Width="35" Height="40" Click="PlusButton_Click"></Button>
                        </StackPanel>

                        <TextBlock Text="Скидка" Grid.Column="2" Grid.Row="0" FontSize="25"></TextBlock>
                        <StackPanel Orientation="Horizontal" Grid.Column="2" Grid.Row="1"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProductDiscountAmount}" Grid.Column="1" Grid.Row="2" 
                           HorizontalAlignment="Center" FontSize="35"></TextBlock>
                            <TextBlock Text=" %" Grid.Column="2" Grid.Row="3" FontSize="35"></TextBlock>
                        </StackPanel>
                        <Button Grid.Column="2" Grid.Row="3" HorizontalAlignment="Right"
                                Content="Удалить" Name="DeleteProductButton" Click="DeleteProductButton_Click"></Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
